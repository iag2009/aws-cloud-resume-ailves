"""CloudFront viewer-request trigger: увеличивает счётчик просмотров страницы.

Файл генерируется Terraform из func-cfle.py.tftpl — не редактировать копию
в .zip и не хардкодить сюда имя таблицы.

Lambda@Edge вызывается на КАЖДЫЙ viewer-request, включая попадания в кэш и
каждый статический ассет. Отсюда два требования:

  1. Функция должна быть дешёвой — никакой отладочной печати. Раньше пять
     print() на вызов накопили ~128 МБ логов в восьми регионах.
  2. Функция не имеет права падать. Необработанное исключение в
     viewer-request возвращает посетителю HTTP 503, то есть недоступность
     DynamoDB роняет весь сайт. Запрос возвращается в любом случае.
"""

import logging

import boto3
from botocore.config import Config

logger = logging.getLogger()
logger.setLevel(logging.WARNING)

TABLE_NAME = "${table_name}"
TABLE_REGION = "${table_region}"

# CloudFront применяет default_root_object УЖЕ ПОСЛЕ viewer-request, поэтому
# заход на корень сайта приходит сюда как "/", а не как "/index.html".
# Прежняя проверка только на "/index.html" — причина того, что счётчик стоял.
COUNTED_URIS = frozenset(("/", "/index.html"))

# Edge-регион может быть далеко от региона таблицы, поэтому таймауты жёсткие:
# медленный вызов DynamoDB задержал бы запрос посетителя.
_table = boto3.resource(
    "dynamodb",
    region_name=TABLE_REGION,
    config=Config(
        connect_timeout=1,
        read_timeout=2,
        retries={"max_attempts": 1, "mode": "standard"},
    ),
).Table(TABLE_NAME)


def handler(event, context):
    request = event["Records"][0]["cf"]["request"]

    if request["method"] == "GET" and request["uri"] in COUNTED_URIS:
        try:
            # ADD атомарен на стороне DynamoDB. Прежняя пара get_item/put_item
            # теряла просмотры при одновременном заходе двух посетителей.
            _table.update_item(
                Key={"id": "total"},
                UpdateExpression="ADD #v :inc",
                ExpressionAttributeNames={"#v": "views"},
                ExpressionAttributeValues={":inc": 1},
            )
        except Exception:
            logger.exception("failed to increment view counter")

    # Прежде здесь же велась запись по каждому IP-адресу посетителя. Это
    # персональные данные без основания и без срока хранения, и никто их
    # не читал, поэтому пер-IP счётчик убран.
    return request
