"""HTTP endpoint behind the Lambda Function URL: the page view counter.

Generated by Terraform from func.py.tftpl.

  GET   returns the current count
  POST  increments it and returns the new count

The increment used to run in a Lambda@Edge viewer-request trigger, i.e. on
every request for every asset. The page now POSTs once per browser session
instead (website/index.js).

CORS headers come from the Function URL itself (the cors block in lambda.tf),
so there is no need to repeat them here.
"""

import json
import logging

import boto3
from botocore.config import Config

logger = logging.getLogger()
logger.setLevel(logging.WARNING)

TABLE_NAME = "${table_name}"
TABLE_REGION = "${table_region}"

_table = boto3.resource(
    "dynamodb",
    region_name=TABLE_REGION,
    config=Config(
        connect_timeout=1,
        read_timeout=2,
        retries={"max_attempts": 2, "mode": "standard"},
    ),
).Table(TABLE_NAME)


def _response(status, body):
    return {
        "statusCode": status,
        "headers": {
            "Content-Type": "application/json",
            # The counter changes constantly, so the response must not be cached.
            "Cache-Control": "no-store",
        },
        "body": json.dumps(body),
    }


def _increment():
    # ADD is atomic server-side and creates the item on first use; a
    # get_item/put_item pair would lose views under concurrent visits.
    return _table.update_item(
        Key={"id": "total"},
        UpdateExpression="ADD #v :inc",
        ExpressionAttributeNames={"#v": "views"},
        ExpressionAttributeValues={":inc": 1},
        ReturnValues="UPDATED_NEW",
    )["Attributes"]


def handler(event, context):
    # OPTIONS preflights never reach the code: the Function URL answers them
    # from the cors block in lambda.tf.
    method = event.get("requestContext", {}).get("http", {}).get("method", "GET")
    if method not in ("GET", "POST"):
        return _response(405, {"error": "method not allowed"})

    try:
        if method == "POST":
            item = _increment()
        else:
            item = _table.get_item(Key={"id": "total"}).get("Item") or {}
    except Exception:
        logger.exception("failed to %s view counter", "update" if method == "POST" else "read")
        return _response(503, {"error": "counter unavailable"})

    return _response(200, {"views": int(item.get("views", 0))})
