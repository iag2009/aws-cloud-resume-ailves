.DS_Store

# A typo ("assetss", three s) meant this rule never matched, so the 246 MB
# video CV ended up in the repository: .git weighs 498 MB.
website/assets/*.mp4

# Lambda build artifacts: the .zip is produced by data.archive_file from
# envs/dev/lambda/*.py.tftpl and does not belong in version control.
envs/*/lambda/*.zip

envs/tst/**
envs/dev/outputfile.txt
envs/dev/payload.json
envs/dev/payload_base64.txt

# Saved plans embed values from state; local command logs.
tfplan
*.tfplan
out.txt
